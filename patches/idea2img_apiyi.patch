+def _normalize_transcript(transcript):
+    """Convert Idea2Img's message format to the OpenAI-compatible one.
+
+    Upstream builds `content` as a list of bare Python strings interleaved with
+    image dicts, which was valid for the Azure GPT-4V deployment it targeted. The
+    OpenAI-compatible endpoint rejects it outright -- HTTP 400, "contents is
+    required" -- and gptv_query's retry loop then spins without ever surfacing the
+    cause. Strings become {"type": "text", ...}; image entries already have the
+    right shape and pass through untouched.
+    """
+    out = []
+    for msg in transcript or []:
+        c = msg.get("content")
+        if isinstance(c, list):
+            parts = []
+            for item in c:
+                if isinstance(item, str):
+                    parts.append({"type": "text", "text": item})
+                elif isinstance(item, dict):
+                    parts.append(item)
+            c = parts
+        out.append({"role": msg.get("role", "user"), "content": c})
+    return out
+
