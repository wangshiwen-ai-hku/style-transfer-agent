+# --- APIYI integration (added for the TVCG revision) -------------------------
+# Idea2Img is used as a backbone-controlled baseline: the orchestration is theirs,
+# the generator is ours. --t2i apiyi swaps SDXL for the same image model AgenticST
+# uses (and needs no GPU); --t2i sdxl reproduces the paper's original setting.
+import os as _os
+_PROJ = _os.path.abspath(_os.path.join(_os.path.dirname(__file__), "..", ".."))
+try:
+    from dotenv import load_dotenv as _ld
+    _ld(_os.path.join(_PROJ, ".env"))
+except Exception:
+    pass
+APIYI_BASE_URL = _os.environ.get("BASE_URL", "https://api.apiyi.com/v1")
+LM_MODEL = _os.environ.get("IDEA2IMG_LM_MODEL", "gemini-2.5-flash")
+GEN_MODEL = _os.environ.get("IDEA2IMG_GEN_MODEL", "gemini-2.5-flash-image")
+
+
+class t2i_apiyi():
+    """Drop-in replacement for t2i_sdxl backed by APIYI, no GPU required."""
+    def __init__(self, *a, **kw):
+        import sys as _sys
+        if _PROJ not in _sys.path:
+            _sys.path.insert(0, _PROJ)
+        from src.utils import apiyi as _apiyi
+        self._apiyi = _apiyi
+
+    def inference(self, prompt, savename):
+        img = self._apiyi.generate_image(prompt, model=GEN_MODEL)
+        img.convert("RGB").save(savename)
+
+    def img2img_inference(self, image, prompt, savename, strength=1.0):
+        import tempfile
+        with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as f:
+            tmp = f.name
+        image.convert("RGB").save(tmp)
+        img = self._apiyi.generate_image(
+            prompt, image_paths=[tmp],
+            image_clare_prompt=["Image 1 is the current image to revise."],
+            model=GEN_MODEL)
+        img.convert("RGB").save(savename)
+        _os.unlink(tmp)
+# -----------------------------------------------------------------------------
