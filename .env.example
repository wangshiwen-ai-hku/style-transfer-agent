# OpenAI-compatible endpoint used for every model call, reasoning and generation.
BASE_URL=https://api.apiyi.com/v1
APIYI_KEY=

# Optional overrides. The defaults are what the paper reports.
# AGENTICST_LM_MODEL=gemini-2.5-flash
# AGENTICST_GEN_MODEL=gemini-2.5-flash-image

# Forces output framing by reordering reference images. OFF for every reported
# number; see the README before enabling it.
# AGENTICST_PRESERVE_FRAMING=0
